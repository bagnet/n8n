      "id": "check-graph24",
      "name": "Графік 24г?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 100]
    },
    {
      "parameters": {
        "jsCode": "// Генерація графіку SOC за 24 години\nconst hours = Array.from({length: 24}, (_, i) => i);\nconst socData = hours.map(h => {\n  // Симуляція даних (в реальності тут були б дані з БД)\n  const baseSOC = 85;\n  const variation = Math.sin(h / 24 * Math.PI * 2) * 15;\n  return Math.max(20, Math.min(100, baseSOC + variation));\n});\n\nconst chartConfig = {\n  type: 'line',\n  data: {\n    labels: hours.map(h => h + ':00'),\n    datasets: [{\n      label: 'SOC %',\n      data: socData,\n      borderColor: 'rgb(75, 192, 192)',\n      backgroundColor: 'rgba(75, 192, 192, 0.2)',\n      tension: 0.4,\n      fill: true\n    }]\n  },\n  options: {\n    responsive: true,\n    plugins: {\n      title: {\n        display: true,\n        text: 'Заряд батареї за 24 години',\n        font: { size: 16 }\n      },\n      legend: {\n        display: true\n      }\n    },\n    scales: {\n      y: {\n        beginAtZero: false,\n        min: 0,\n        max: 100,\n        title: {\n          display: true,\n          text: 'SOC %'\n        }\n      },\n      x: {\n        title: {\n          display: true,\n          text: 'Час'\n        }\n      }\n    }\n  }\n};\n\nconst chartUrl = `https://quickchart.io/chart?c=${encodeURIComponent(JSON.stringify(chartConfig))}&width=800&height=400&backgroundColor=white`;\n\nreturn {\n  json: {\n    chartUrl: chartUrl,\n    callbackQueryId: $input.item.json.body.callback_query.id,\n    chatId: $input.item.json.body.callback_query.message.chat.id\n  }\n};"
      },
      "id": "generate-graph24",
      "name": "Генерувати Графік 24г",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 50]
    },
