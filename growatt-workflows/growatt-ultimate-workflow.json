      "parameters": {
        "chatId": "={{$env.TELEGRAM_CHAT_ID}}",
        "text": "=*Growatt Дім* ⚡️🇺🇦\n\n🔋 Батарея: *{{$json[\"data\"][\"batteryPercent\"]}}%* ({{$json[\"data\"][\"vBat\"]}} В)\n{{$json[\"data\"][\"pCharge\"]>100?'⬆️':'⬇️'}} {{$json[\"data\"][\"pCharge\"]>100?'Заряд':'Розряд'}}: *{{Math.abs($json[\"data\"][\"pCharge\"]/1000).toFixed(2)}} кВт*\n☀️ Сонце → *{{($json[\"data\"][\"ppv\"]/1000).toFixed(1)}} кВт*\n🔌 Мережа: {{$json[\"data\"][\"vAc\"]}} В\n🌡 Температура: {{$json[\"data\"][\"tempBat\"]}}°C\n\n📅 {{$now.format('DD.MM.YYYY HH:mm')}}",
