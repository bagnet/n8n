# Growatt n8n Workflow - Приклад змінних середовища
# Скопіюй цей файл в .env та заповни своїми даними

# ===== SHINEPHONE CREDENTIALS =====
# Твій email/логін від ShinePhone додатку
SHINEPHONE_LOGIN=tviy_email@gmail.com

# Твій пароль від ShinePhone (можна звичайний або MD5 хеш)
# Для отримання MD5: echo -n "твій_пароль" | md5sum
SHINEPHONE_PASSWORD=tviy_parol_abo_md5_hash

# ===== TELEGRAM SETTINGS =====
# Твій Telegram Chat ID (отримай від @userinfobot)
# Просто напиши /start боту @userinfobot в Telegram
TELEGRAM_CHAT_ID=123456789

# ID Telegram Credential в n8n
# Після створення Telegram API credential в n8n, скопіюй його ID
# Зазвичай це "1", якщо це перший credential
TELEGRAM_CREDENTIAL_ID=1

# ===== TELEGRAM BOT TOKEN =====
# Токен твого бота (вже створено для тебе)
# НЕ ПУБЛІКУЙ цей токен публічно!
TELEGRAM_BOT_TOKEN=8136712370:AAEdVYxRzzBYoUDuTwC68cW2fNA4rtSCC0c

# ===== GROWATT API SETTINGS (опціонально) =====
# Зазвичай не потрібно змінювати
GROWATT_API_URL=https://server.growatt.com

# ===== ІНШІ НАЛАШТУВАННЯ =====
# Інтервал оновлення в хвилинах (за замовчуванням 5)
UPDATE_INTERVAL_MINUTES=5

# Поріг тривоги для низького заряду (%)
LOW_BATTERY_THRESHOLD=28

# Поріг для повної зарядки (%)
FULL_BATTERY_THRESHOLD=94
